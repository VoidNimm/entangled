{
  "name": "entangled",
  "version": "1.0.0",
  "description": "A scroll-driven experience through the noise, heat, and quiet of how we think. One mind. Four states.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:layout": "node scripts/layout-check.mjs",
    "check:resilience": "node scripts/resilience-check.mjs",
    "check:a11y": "node scripts/a11y-check.mjs",
    "check:all": "npm run check:layout && npm run check:resilience && npm run check:a11y",
    "encode": "node scripts/encode-clips.mjs",
    "analyze:luminance": "node scripts/luminance.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
